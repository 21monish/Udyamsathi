# Copy these names to Render Environment. Never commit the real values.
# Use the full Supabase Transaction Pooler URI (port 6543) for DATABASE_URL.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=https://your-project.vercel.app
GEMINI_API_KEY=
DEBUG=false
